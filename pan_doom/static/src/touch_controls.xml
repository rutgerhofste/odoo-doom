<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pan_doom.TouchControls">
        <div class="o_pan_doom_touch" t-ref="layer" role="dialog" aria-modal="true" aria-label="ODooM"
             t-on-contextmenu.prevent="() => {}">
            <t t-slot="default"/>
            <div class="o_pan_doom_stick_zone"
                 t-on-pointerdown="stickStart"
                 t-on-pointermove="stickMove"
                 t-on-pointerup="stickEnd"
                 t-on-pointercancel="stickEnd">
                <div t-if="stick.pointer !== null" class="o_pan_doom_stick"
                     t-attf-style="left: {{ stick.x }}px; top: {{ stick.y }}px;">
                    <div class="o_pan_doom_knob"
                         t-attf-style="transform: translate({{ stick.dx }}px, {{ stick.dy }}px);"/>
                </div>
                <div t-else="" class="o_pan_doom_stick o_pan_doom_stick_rest">
                    <div class="o_pan_doom_knob"/>
                </div>
            </div>
            <t t-foreach="constructor.BUTTONS" t-as="button" t-key="button.name">
                <button type="button" t-attf-class="o_pan_doom_btn o_pan_doom_{{ button.name }}"
                        t-on-pointerdown="(ev) => this.press(ev, 0, button)"
                        t-on-pointerup="(ev) => this.press(ev, 1, button)"
                        t-on-pointercancel="(ev) => this.press(ev, 1, button)"
                        t-esc="button.label"/>
            </t>
            <button type="button" class="o_pan_doom_btn o_pan_doom_close" aria-label="Back to Odoo"
                    t-on-click="close" t-on-pointerup="close">✕</button>
            <p t-if="state.hint" class="o_pan_doom_hint">Tap Fire to start. Your left thumb moves.</p>
            <p class="o_pan_doom_notice">Unofficial fan project, not for sale. DOOM is a trademark of id Software.</p>
        </div>
    </t>
</templates>
