<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pan_doom.DoomAction">
        <div class="o_pan_doom">
            <TouchControls t-if="isTouch" onKey="key">
                <t t-call="pan_doom.DoomScreen"/>
            </TouchControls>
            <t t-else="">
                <t t-call="pan_doom.DoomScreen"/>
                <p class="o_pan_doom_help">
                    Click the screen to play. Arrows move, Ctrl fires, Space opens doors,
                    Enter selects, Y answers yes, Esc opens the menu. Shift+Tab gives the
                    keyboard back to Odoo.
                </p>
                <p class="o_pan_doom_help">
                    Unofficial fan project, not for sale. DOOM is a trademark of id Software.
                </p>
            </t>
        </div>
    </t>

    <t t-name="pan_doom.DoomScreen">
        <div class="o_pan_doom_screen">
            <canvas t-ref="canvas" class="o_pan_doom_canvas" width="640" height="400" tabindex="0"
                    role="application" aria-label="Doom game"
                    t-on-keydown="(ev) => this.onKey(ev, 0)"
                    t-on-keyup="(ev) => this.onKey(ev, 1)"
                    t-on-blur="releaseKeys"/>
            <div t-if="state.status !== 'playing'" class="o_pan_doom_overlay" role="status">
                <p t-esc="state.message"/>
                <button t-if="state.status !== 'loading'" type="button" class="o_pan_doom_again"
                        t-on-click="restart" t-on-pointerup="restart">
                    <t t-esc="state.status === 'failed' ? 'Try again' : 'Play again'"/>
                </button>
            </div>
        </div>
    </t>
</templates>
